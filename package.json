{
  "name": "gas-story",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5310",
    "build": "vite build",
    "preview": "vite preview --host --port 5311",
    "android": "npm run build && cap sync android && cap open android",
    "sync": "npm run build && cap sync",
    "assets": "node scripts/make-assets.mjs && capacitor-assets generate --android --iconBackgroundColor '#2b9bf0' --splashBackgroundColor '#a8dcff'",
    "sfx": "node scripts/make-sfx.mjs",
    "bots": "node scripts/botrun.mjs",
    "apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/baloo-2": "^5.3.0",
    "peerjs": "^1.5.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}