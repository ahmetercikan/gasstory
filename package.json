{
  "name": "gas-story",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5310",
    "build": "vite build",
    "preview": "vite preview --host --port 5311",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "ipa": "npm run build && cap sync ios && sh scripts/ios-testflight.sh",
    "sync": "npm run build && cap sync",
    "assets": "node scripts/make-assets.mjs && capacitor-assets generate --android --ios --iconBackgroundColor '#2b9bf0' --splashBackgroundColor '#a8dcff'",
    "sfx": "node scripts/make-sfx.mjs",
    "bots": "node scripts/botrun.mjs",
    "apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "store:shots": "node scripts/store-shots.mjs",
    "store:mascots": "node scripts/store-mascots.mjs",
    "store:panorama": "node scripts/store-panorama.mjs",
    "aab": "npm run build && cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/baloo-2": "^5.3.0",
    "firebase": "^12.19.0",
    "lucide": "^0.577.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
