{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length <= 12" }
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid)"
      }
    },
    "status": {
      "$uid": { ".read": "auth != null", ".write": "auth != null && auth.uid === $uid" }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$f": { ".write": "auth != null && auth.uid === $f" }
      }
    },
    "requests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$from": { ".write": "auth != null && auth.uid === $from" }
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$from": { ".write": "auth != null && auth.uid === $from" }
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["open"],
      "$code": {
        ".write": "auth != null && (!data.exists() ? newData.child('host').val() === auth.uid : data.child('host').val() === auth.uid)",
        "msgs": { ".indexOn": ["t"] },
        "join": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
        "in": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
        "dm": { "$uid": { ".write": "auth != null && auth.uid === $uid" } }
      }
    }
  }
}
